digraph microkit {
  compound=true;

  // Do not edit this file as it will be overwritten if HAMR codegen is rerun

  // protection domains
  graph [style=rounded]
  subgraph cluster_tsproc_tempSensor_MON {
    label = "tsproc_tempSensor_MON";
    tsproc_tempSensor_MON_INVIS [label="", style=invis, width=.5, height=.5, fixedsize=true]

    graph [style=rounded]
    subgraph cluster_tsproc_tempSensor {
      label = "tsproc_tempSensor";
      tsproc_tempSensor_INVIS [label="", style=invis, width=.5, height=.5, fixedsize=true]

      pd_tsproc_tempSensor_currentTemp_queue_1 [label=currentTemp_queue_1];
    }
  }

  graph [style=rounded]
  subgraph cluster_tcproc_tempControl_MON {
    label = "tcproc_tempControl_MON";
    tcproc_tempControl_MON_INVIS [label="", style=invis, width=.5, height=.5, fixedsize=true]

    graph [style=rounded]
    subgraph cluster_tcproc_tempControl {
      label = "tcproc_tempControl";
      tcproc_tempControl_INVIS [label="", style=invis, width=.5, height=.5, fixedsize=true]

      pd_tcproc_tempControl_currentTemp_queue_1 [label=currentTemp_queue_1];
      pd_tcproc_tempControl_fanCmd_queue_1 [label=fanCmd_queue_1];
      pd_tcproc_tempControl_setPoint_queue_1 [label=setPoint_queue_1];
      pd_tcproc_tempControl_fanAck_queue_1 [label=fanAck_queue_1];
    }
  }

  graph [style=rounded]
  subgraph cluster_oiproc_operatorInterface_MON {
    label = "oiproc_operatorInterface_MON";
    oiproc_operatorInterface_MON_INVIS [label="", style=invis, width=.5, height=.5, fixedsize=true]

    graph [style=rounded]
    subgraph cluster_oiproc_operatorInterface {
      label = "oiproc_operatorInterface";
      oiproc_operatorInterface_INVIS [label="", style=invis, width=.5, height=.5, fixedsize=true]

      pd_oiproc_operatorInterface_currentTemp_queue_1 [label=currentTemp_queue_1];
      pd_oiproc_operatorInterface_setPoint_queue_1 [label=setPoint_queue_1];
    }
  }

  graph [style=rounded]
  subgraph cluster_fanproc_fan_MON {
    label = "fanproc_fan_MON";
    fanproc_fan_MON_INVIS [label="", style=invis, width=.5, height=.5, fixedsize=true]

    graph [style=rounded]
    subgraph cluster_fanproc_fan {
      label = "fanproc_fan";
      fanproc_fan_INVIS [label="", style=invis, width=.5, height=.5, fixedsize=true]

      pd_fanproc_fan_fanCmd_queue_1 [label=fanCmd_queue_1];
      pd_fanproc_fan_fanAck_queue_1 [label=fanAck_queue_1];
    }
  }

  graph [style=rounded]
  subgraph cluster_pacer {
    label = "pacer";
    pacer_INVIS [label="", style=invis, width=.5, height=.5, fixedsize=true]

  }

  // memory regions
  TempControlSystem_i_Instance_tsproc_tempSensor_currentTemp_1_Memory_Region;

  TempControlSystem_i_Instance_tcproc_tempControl_fanCmd_1_Memory_Region;

  TempControlSystem_i_Instance_oiproc_operatorInterface_setPoint_1_Memory_Region;

  TempControlSystem_i_Instance_fanproc_fan_fanAck_1_Memory_Region;

  // channels
  pacer_INVIS -> tsproc_tempSensor_MON_INVIS [lhead=cluster_tsproc_tempSensor_MON, minlen=2, dir=both];
  tsproc_tempSensor_MON_INVIS -> tsproc_tempSensor_INVIS [lhead=cluster_tsproc_tempSensor, minlen=2, dir=both];
  pacer_INVIS -> tcproc_tempControl_MON_INVIS [lhead=cluster_tcproc_tempControl_MON, minlen=2, dir=both];
  tcproc_tempControl_MON_INVIS -> tcproc_tempControl_INVIS [lhead=cluster_tcproc_tempControl, minlen=2, dir=both];
  pacer_INVIS -> oiproc_operatorInterface_MON_INVIS [lhead=cluster_oiproc_operatorInterface_MON, minlen=2, dir=both];
  oiproc_operatorInterface_MON_INVIS -> oiproc_operatorInterface_INVIS [lhead=cluster_oiproc_operatorInterface, minlen=2, dir=both];
  pacer_INVIS -> fanproc_fan_MON_INVIS [lhead=cluster_fanproc_fan_MON, minlen=2, dir=both];
  fanproc_fan_MON_INVIS -> fanproc_fan_INVIS [lhead=cluster_fanproc_fan, minlen=2, dir=both];

  // shared memory mappings
  pd_tsproc_tempSensor_currentTemp_queue_1 -> TempControlSystem_i_Instance_tsproc_tempSensor_currentTemp_1_Memory_Region [dir=both, style=dashed];
  pd_tcproc_tempControl_currentTemp_queue_1 -> TempControlSystem_i_Instance_tsproc_tempSensor_currentTemp_1_Memory_Region [dir=back, style=dashed];
  pd_tcproc_tempControl_fanCmd_queue_1 -> TempControlSystem_i_Instance_tcproc_tempControl_fanCmd_1_Memory_Region [dir=both, style=dashed];
  pd_tcproc_tempControl_setPoint_queue_1 -> TempControlSystem_i_Instance_oiproc_operatorInterface_setPoint_1_Memory_Region [dir=back, style=dashed];
  pd_tcproc_tempControl_fanAck_queue_1 -> TempControlSystem_i_Instance_fanproc_fan_fanAck_1_Memory_Region [dir=back, style=dashed];
  pd_oiproc_operatorInterface_currentTemp_queue_1 -> TempControlSystem_i_Instance_tsproc_tempSensor_currentTemp_1_Memory_Region [dir=back, style=dashed];
  pd_oiproc_operatorInterface_setPoint_queue_1 -> TempControlSystem_i_Instance_oiproc_operatorInterface_setPoint_1_Memory_Region [dir=both, style=dashed];
  pd_fanproc_fan_fanCmd_queue_1 -> TempControlSystem_i_Instance_tcproc_tempControl_fanCmd_1_Memory_Region [dir=back, style=dashed];
  pd_fanproc_fan_fanAck_queue_1 -> TempControlSystem_i_Instance_fanproc_fan_fanAck_1_Memory_Region [dir=both, style=dashed];
}